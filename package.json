{
	"name": "drawio-to-excalidraw",
	"version": "1.0.0",
	"description": "Convert draw.io XML stencils to SVG and Excalidraw library format",
	"type": "module",
	"main": "xml-to-excalidraw.js",
	"bin": {
		"drawio-to-svg": "./xml-to-svg.js",
		"drawio-to-excalidraw": "./xml-to-excalidraw.js"
	},
	"scripts": {
		"xml-to-svg": "node xml-to-svg.js",
		"xml-to-excalidraw": "node xml-to-excalidraw.js"
	},
	"keywords": [
		"drawio",
		"excalidraw",
		"converter",
		"svg",
		"stencils",
		"diagrams",
		"shapes"
	],
	"author": "Frankie Liu",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/frankieliu/drawio-to-excalidraw.git"
	},
	"bugs": {
		"url": "https://github.com/frankieliu/drawio-to-excalidraw/issues"
	},
	"homepage": "https://github.com/frankieliu/drawio-to-excalidraw#readme",
	"dependencies": {
		"commander": "^14.0.3",
		"dommatrix": "^0.1.1",
		"jsdom": "^28.0.0",
		"svg-to-excalidraw": "^0.0.2",
		"xml2js": "^0.6.2"
	},
	"engines": {
		"node": ">=16.0.0"
	}
}
